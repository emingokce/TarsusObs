@model List<Department>
@{
    ViewData["Title"] = "Department Page";
}

<div class="text-center">
 






<div class="container mt-5">
    <h2 class="mb-4">Kullanıcı Listesi</h2>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Bölüm Kodu</th>
                    <th scope="col">Bölüm Adı</th>
                   
                    <th scope="col" class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var d in @Model)
                {
                <tr>
                    <th scope="row">@d.Id</th>
                    <td>@d.DepCode</td>
                    <td>@d.DepName</td>
                    
                    <td class="text-center">
                        <a href="/Department/Update?id=@d.Id" class="btn btn-sm btn-outline-primary me-2"><i class="bi bi-pencil"></i> Güncelle   </a>
                        <a href="/Department/Delete?id=@d.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                    </td>
                </tr>
               }
            </tbody>
        </table>
    </div>
</div>













</div>
